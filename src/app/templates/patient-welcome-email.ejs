<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Welcome to Healthcare Portal</title>
  <style>
    /* Reset styles for email clients */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    table { border-collapse: collapse !important; }
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #f4f7f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    
    /* Responsive styles */
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; padding: 10px !important; }
      .content-cell { padding: 24px 20px !important; }
      .hero-title { font-size: 22px !important; }
      .feature-box { padding: 14px !important; }
      .cta-button { width: 100% !important; text-align: center !important; display: block !important; box-sizing: border-box !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7f9; color: #334155;">
  <!-- Main Container Table -->
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f7f9; padding: 40px 0;">
    <tr>
      <td align="center">
        <!-- Card Wrapper -->
        <table class="email-container" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
          
          <!-- Top Decorative Header Bar (Teal to Blue Gradient) -->
          <tr>
            <td style="background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%); height: 8px; width: 100%;"></td>
          </tr>

          <!-- Header Section -->
          <tr>
            <td align="center" style="padding: 36px 32px 20px 32px; background-color: #ffffff;">
              <!-- Welcome Icon Badge -->
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="width: 68px; height: 68px; background: linear-gradient(135deg, #e0f2fe 0%, #ccfbf1 100%); border-radius: 50%;">
                    <!-- Heart / Healthcare Pulse Icon -->
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                      <path d="M12 5v14"/>
                    </svg>
                  </td>
                </tr>
              </table>
              <h1 class="hero-title" style="margin: 20px 0 8px 0; font-size: 26px; font-weight: 700; color: #0f172a; letter-spacing: -0.5px;">Welcome to Our Healthcare Portal!</h1>
              <p style="margin: 0; font-size: 15px; color: #64748b; font-weight: 500;">Your trusted partner in personalized healthcare & wellness</p>
            </td>
          </tr>

          <!-- Main Content Body -->
          <tr>
            <td class="content-cell" style="padding: 10px 32px 32px 32px; background-color: #ffffff;">
              <p style="font-size: 15px; line-height: 1.6; color: #334155; margin-bottom: 24px;">
                Hello <strong><%= typeof name !== 'undefined' && name ? name : 'Valued Patient' %></strong>,
                <br><br>
                Thank you for joining our Healthcare Portal! We are delighted to welcome you to a modern, seamless healthcare experience designed to make managing your medical care effort-free and secure.
              </p>

              <!-- Account Details Box -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 28px;">
                <tr>
                  <td style="padding: 18px 20px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td style="font-size: 13px; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;" colspan="2">
                          Account Confirmation
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-top: 8px; font-size: 14px; color: #334155; font-weight: 500;">
                          Registered Email:
                        </td>
                        <td align="right" style="padding-top: 8px; font-size: 14px; color: #0f172a; font-weight: 600;">
                          <%= typeof email !== 'undefined' && email ? email : 'Your Email Address' %>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-top: 6px; font-size: 14px; color: #334155; font-weight: 500;">
                          Account Status:
                        </td>
                        <td align="right" style="padding-top: 6px; font-size: 14px; color: #16a34a; font-weight: 600;">
                          <span style="display: inline-block; width: 8px; height: 8px; background-color: #16a34a; border-radius: 50%; margin-right: 4px;"></span> Verified & Active
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- What You Can Do Section -->
              <h2 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 16px 0;">Here is what you can do with your account:</h2>

              <!-- Feature Grid / List -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 28px;">
                
                <!-- Feature 1 -->
                <tr>
                  <td style="padding-bottom: 14px;">
                    <table class="feature-box" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f0f9ff; border-radius: 10px; border-left: 4px solid #0284c7;">
                      <tr>
                        <td style="padding: 14px 16px;">
                          <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                              <td width="36" valign="top">
                                <!-- Calendar Icon -->
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                  <line x1="16" y1="2" x2="16" y2="6"></line>
                                  <line x1="8" y1="2" x2="8" y2="6"></line>
                                  <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                              </td>
                              <td style="padding-left: 10px;">
                                <div style="font-size: 14px; font-weight: 700; color: #0369a1; margin-bottom: 2px;">Easy Appointment Booking</div>
                                <div style="font-size: 13px; color: #475569; line-height: 1.4;">Schedule and manage doctor appointments effortlessly online.</div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Feature 2 -->
                <tr>
                  <td style="padding-bottom: 14px;">
                    <table class="feature-box" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f0fdf4; border-radius: 10px; border-left: 4px solid #10b981;">
                      <tr>
                        <td style="padding: 14px 16px;">
                          <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                              <td width="36" valign="top">
                                <!-- File Text / Medical Records Icon -->
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                  <polyline points="14 2 14 8 20 8"></polyline>
                                  <line x1="16" y1="13" x2="8" y2="13"></line>
                                  <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                              </td>
                              <td style="padding-left: 10px;">
                                <div style="font-size: 14px; font-weight: 700; color: #15803d; margin-bottom: 2px;">Digital Health Records & Prescriptions</div>
                                <div style="font-size: 13px; color: #475569; line-height: 1.4;">View your medical histories, test reports, and prescriptions securely anytime.</div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Feature 3 -->
                <tr>
                  <td style="padding-bottom: 0;">
                    <table class="feature-box" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fefce8; border-radius: 10px; border-left: 4px solid #eab308;">
                      <tr>
                        <td style="padding: 14px 16px;">
                          <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                              <td width="36" valign="top">
                                <!-- User / Doctor Icon -->
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                  <circle cx="9" cy="7" r="4"></circle>
                                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                              </td>
                              <td style="padding-left: 10px;">
                                <div style="font-size: 14px; font-weight: 700; color: #a16207; margin-bottom: 2px;">Doctor Consultations & Support</div>
                                <div style="font-size: 13px; color: #475569; line-height: 1.4;">Connect with licensed healthcare specialists for consultation and guidance.</div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

              </table>

              <!-- Action Call to Action Button -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="<%= typeof dashboardUrl !== 'undefined' && dashboardUrl ? dashboardUrl : '#' %>" class="cta-button" style="display: inline-block; background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%); color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 700; padding: 14px 32px; border-radius: 10px; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25); letter-spacing: 0.2px;">
                      Go to Patient Dashboard &rarr;
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Help Box -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;">
                <tr>
                  <td style="padding: 14px 16px; text-align: center;">
                    <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;">
                      Have questions or need assistance? Reach out to our 24/7 patient support team at 
                      <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@healthcare.com' %>" style="color: #0284c7; text-decoration: none; font-weight: 600;">
                        <%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@healthcare.com' %>
                      </a>.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 24px 32px; border-top: 1px solid #e2e8f0; text-align: center;">
              <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 600; color: #475569;">Healthcare Patient Support Team</p>
              <p style="margin: 0; font-size: 12px; color: #94a3b8; line-height: 1.5;">
                You received this email because you registered an account on our Healthcare Portal.
                <br>&copy; <%= new Date().getFullYear() %> Healthcare Portal. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
